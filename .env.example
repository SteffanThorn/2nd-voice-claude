# Copy to .env.local and fill in. Never commit .env.local.

# ElevenLabs text-to-speech (server-only; no NEXT_PUBLIC_ prefix).
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The voice used for Māori audio. Pick one in the ElevenLabs Voice Library and copy its Voice ID.
ELEVENLABS_VOICE_ID=

# --- Experimental voices (for comparison only; not Māori voices) ---

# Google Cloud Text-to-Speech: reads Māori with a voice from another language.
# Create a key in Google Cloud (enable "Cloud Text-to-Speech API"; restrict the key to that API).
GOOGLE_TTS_API_KEY=
# Borrowed voice language (default es-ES). Others to try: it-IT, id-ID, en-AU.
GOOGLE_TTS_LANGUAGE_CODE=es-ES
# Optional exact voice name from Google's voice list; leave empty for Google's default.
GOOGLE_TTS_VOICE_NAME=

# eSpeak NG: free, built-in Māori rules, robotic. Runs inside the app, no key needed.
ESPEAK_NG_ENABLED=false
