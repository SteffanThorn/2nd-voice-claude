# Copy to .env.local and fill in. Never commit .env.local.

# ElevenLabs text-to-speech (server-only; no NEXT_PUBLIC_ prefix).
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The voice used for Māori audio. Pick one in the ElevenLabs Voice Library and copy its Voice ID.
ELEVENLABS_VOICE_ID=

# Show AI-written sample content in a production build (default: hidden).
# SHOW_SAMPLE_CONTENT=true
